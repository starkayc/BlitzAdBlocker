<Window x:Class="BlitzAdBlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Blitz AdBlocker"
        Width="470" Height="430"
        MinWidth="430" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBg}"
        FontFamily="{DynamicResource FontDisplay}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="{DynamicResource WindowBg}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/blitz.ico" Width="20" Height="20" Stretch="Uniform" Margin="0,0,9,0" />
                    <TextBlock Text="Blitz AdBlocker" FontSize="13" FontFamily="{DynamicResource FontDisplayBold}"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButton}" Click="OnMinimize" ToolTip="Minimize">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;"
                                   Foreground="{DynamicResource IconFg}" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnClose" ToolTip="Close">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;"
                                   Foreground="{DynamicResource IconFg}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="20,6,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status card -->
                <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Top" Margin="0,6,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StatusText" Text="Checking…" FontSize="14.5"
                                       FontFamily="{DynamicResource FontDisplaySemi}"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="StatusDetail" FontSize="11" FontFamily="{DynamicResource FontBody}"
                                       Foreground="{DynamicResource FooterFg}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Actions -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnEnable" Style="{StaticResource PrimaryButton}"
                            FontFamily="{DynamicResource FontDisplaySemi}"
                            Click="OnEnable" IsEnabled="False" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ShieldCheckGeometry}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,8,0" />
                            <TextBlock Text="Enable" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="BtnDisable" Style="{StaticResource SecondaryButton}"
                            FontFamily="{DynamicResource FontDisplaySemi}"
                            Click="OnDisable" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PowerGeometry}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource Danger}" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,8,0" />
                            <TextBlock Text="Disable" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="Refresh status"
                            Click="OnRefresh">
                        <Path Data="{StaticResource RefreshGeometry}" Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                </Grid>

                <!-- Domains -->
                <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="BLOCKED DOMAINS" FontSize="10"
                                   FontFamily="{DynamicResource FontBodySemi}"
                                   Foreground="{DynamicResource FooterFg}" Margin="0,0,0,6" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DomainListBox" FontSize="10.5" FontFamily="{DynamicResource FontBody}"
                                       Foreground="{DynamicResource FooterFg}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer -->
                <TextBlock Grid.Row="3" FontFamily="{DynamicResource FontBody}" FontSize="10.5"
                           Foreground="{DynamicResource FooterFg}" LineHeight="15" TextWrapping="Wrap">
                    <Run Text="Hosts entries live between the " />
                    <Run Text="# BEGIN BLITZADBLOCK" FontFamily="{DynamicResource FontBodySemi}" />
                    <Run Text=" and " />
                    <Run Text="# END BLITZADBLOCK" FontFamily="{DynamicResource FontBodySemi}" />
                    <Run Text=" markers. A backup (hosts.blitzadblock.bak) is saved before every change." />
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>